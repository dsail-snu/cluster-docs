        },
        {
          "flags": [
            "--resources"
          ],
          "help": "the CPU / memory / GPU table",
          "metavar": ""
        },
        {
          "flags": [
            "-d",
            "--detail"
          ],
          "help": "full node states and reasons, and who is behind each pending reason",
          "metavar": ""
        },
        {
          "flags": [
            "--group"
          ],
          "help": "pending jobs above running ones (--no-group: job ID order)",
          "metavar": ""
        },
        {
          "flags": [
            "--split"
