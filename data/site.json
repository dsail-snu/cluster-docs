{
  "bot": {
    "command": "/cluster",
    "subcommands": [
      {
        "help": "클러스터 계정 신청",
        "name": "join"
      },
      {
        "help": "계정 정리 신청 (졸업 등)",
        "name": "leave"
      },
      {
        "help": "로그인 실패로 차단된 IP 주소의 해제 신청",
        "name": "unban"
      },
      {
        "help": "공동작업 폴더 만들기 (홈 탭에서 관리)",
        "name": "project"
      },
      {
        "help": "공유 데이터(데이터셋, 모델, 컨테이너 이미지) 받아 두기 신청",
        "name": "data"
      },
      {
        "help": "이 안내",
        "name": "help"
      }
    ]
  },
  "chat": {
    "admin_group": "@sysadmin",
    "channels": {
      "admin": "#infra-alerts",
      "announce": "#infra-announce",
      "help": "#infra-help",
      "status": "#infra-status"
    }
  },
