{
  "bot": {
    "command": "/cluster",
    "subcommands": [
      {
        "help": "클러스터 계정 신청",
        "name": "join"
      },
      {
        "help": "계정 정리 신청 (졸업 등)",
        "name": "leave"
      },
      {
        "help": "로그인 실패로 차단된 IP 주소의 해제 신청",
        "name": "unban"
      },
      {
        "help": "공동작업 폴더 만들기 (홈 탭에서 관리)",
        "name": "project"
      },
      {
        "help": "공유 데이터(데이터셋, 모델, 컨테이너 이미지) 받아 두기 신청",
        "name": "data"
      },
      {
        "help": "이 안내",
        "name": "help"
      }
    ]
  },
  "chat": {
    "admin_group": "@sysadmin",
    "channels": {
      "admin": "#infra-alerts",
      "announce": "#infra-announce",
      "help": "#infra-help",
      "status": "#infra-status"
    }
  },
  "commands": {
    "gpu-usage": {
      "options": [
        {
          "flags": [
            "--source"
          ],
          "help": "auto (default: Slurm's figures where the job has them, else Prometheus'), slurm or prometheus",
          "metavar": "WHERE"
        },
        {
          "flags": [
            "--json"
          ],
          "help": "the figures as JSON, for scripts",
          "metavar": ""
        },
        {
          "flags": [
            "--theme"
          ],
          "help": "catppuccin flavour: mocha (default), macchiato, frappe, latte. $CLUSTER_THEME sets it for every cluster command",
          "metavar": "FLAVOUR"
        },
        {
          "flags": [
            "--themes"
          ],
          "help": "list the flavours with a swatch",
          "metavar": ""
        },
        {
          "flags": [
            "--color",
            "--colour"
          ],
          "help": "always, never or auto (default; $NO_COLOR is honoured)",
          "metavar": "WHEN"
        },
        {
          "flags": [
            "--no-color",
            "--no-colour"
          ],
          "help": "the same as --color never",
          "metavar": ""
        },
        {
          "flags": [
            "--ascii"
          ],
          "help": "ASCII glyphs for terminals without UTF-8",
          "metavar": ""
        },
        {
          "flags": [
            "--wide"
          ],
          "help": "every column at full width, whatever the terminal fits",
          "metavar": ""
        }
      ],
      "summary": "what a job's GPUs did: utilisation, SM activity, memory and power, running or finished",
      "summary_ko": "잡의 GPU가 실제로 한 일: 사용률, SM 활동, 메모리, 전력 (실행 중이거나 끝난 잡)",
      "usage": "gpu-usage [OPTIONS] JOB"
    },
    "qos": {
      "options": [
        {
          "flags": [
            "-m",
            "--me"
          ],
          "help": "only the QoS you may submit against",
          "metavar": ""
        },
        {
          "flags": [
            "-a",
            "--all"
          ],
          "help": "include QoS held by no user (Slurm's built-in normal)",
          "metavar": ""
        },
        {
          "flags": [
            "-u",
            "--user"
          ],
          "help": "answer for someone else instead of you",
          "metavar": "NAME"
        },
        {
          "flags": [
            "--usage"
          ],
          "help": "the live usage figures (--no-usage skips the job list)",
          "metavar": ""
        },
        {
          "flags": [
            "--json"
          ],
          "help": "the model as JSON, for scripts (ignores $QOS_OPTIONS)",
          "metavar": ""
        },
        {
          "flags": [
            "--theme"
          ],
          "help": "catppuccin flavour: mocha (default), macchiato, frappe, latte. $CLUSTER_THEME sets it for every cluster command",
          "metavar": "FLAVOUR"
        },
        {
          "flags": [
            "--themes"
          ],
          "help": "list the flavours with a swatch",
          "metavar": ""
        },
        {
          "flags": [
            "--color",
            "--colour"
          ],
          "help": "always, never or auto (default; $NO_COLOR is honoured)",
          "metavar": "WHEN"
        },
        {
          "flags": [
            "--no-color",
            "--no-colour"
          ],
          "help": "the same as --color never",
          "metavar": ""
        },
        {
          "flags": [
            "--ascii"
          ],
          "help": "ASCII glyphs for terminals without UTF-8",
          "metavar": ""
        },
        {
          "flags": [
            "--wide"
          ],
          "help": "every column at full width, whatever the terminal fits",
          "metavar": ""
        }
      ],
      "summary": "the QoS levels you can submit against",
      "summary_ko": "내가 잡을 낼 수 있는 QoS",
      "usage": "qos [OPTIONS]"
    },
    "scratch-space": {
      "options": [
        {
          "flags": [
            "--root"
          ],
          "help": "the scratch space (default /scratch)",
          "metavar": "DIR"
        },
        {
          "flags": [
            "--theme"
          ],
          "help": "catppuccin flavour: mocha (default), macchiato, frappe, latte. $CLUSTER_THEME sets it for every cluster command",
          "metavar": "FLAVOUR"
        },
        {
          "flags": [
            "--themes"
          ],
          "help": "list the flavours with a swatch",
          "metavar": ""
        },
        {
          "flags": [
            "--color",
            "--colour"
          ],
          "help": "always, never or auto (default; $NO_COLOR is honoured)",
          "metavar": "WHEN"
        },
        {
          "flags": [
            "--no-color",
            "--no-colour"
          ],
          "help": "the same as --color never",
          "metavar": ""
        },
        {
          "flags": [
            "--ascii"
          ],
          "help": "ASCII glyphs for terminals without UTF-8",
          "metavar": ""
        },
        {
          "flags": [
            "--wide"
          ],
          "help": "every column at full width, whatever the terminal fits",
          "metavar": ""
        }
      ],
      "summary": "which of your files on the scratch space are due to be cleaned up, and when",
      "summary_ko": "스크래치 공간에서 정리될 예정인 내 파일과 그 시점",
      "usage": "scratch-space [OPTIONS]"
    },
    "sq": {
      "options": [
        {
          "flags": [
            "-m",
            "--me"
          ],
          "help": "only your jobs",
          "metavar": ""
        },
        {
          "flags": [
            "-u",
            "--user"
          ],
          "help": "only these users (comma list; * and ? match)",
          "metavar": "USER"
        },
        {
          "flags": [
            "-p",
            "--partition"
          ],
          "help": "only these partitions",
          "metavar": "PART"
        },
        {
          "flags": [
            "-w",
            "--nodelist"
          ],
          "help": "only these nodes (a hostlist like gpu[1-3,8], or globs)",
          "metavar": "NODES"
        },
        {
          "flags": [
            "-t",
            "--states",
            "--state"
          ],
          "help": "only these job states (R,PD or running,pending; all includes finished)",
          "metavar": "STATES"
        },
        {
          "flags": [
            "-j",
            "--jobs"
          ],
          "help": "only these job IDs",
          "metavar": "IDS"
        },
        {
          "flags": [
            "-A",
            "--account"
          ],
          "help": "only these accounts",
          "metavar": "ACCOUNTS"
        },
        {
          "flags": [
            "-q",
            "--qos"
          ],
          "help": "only these QoS",
          "metavar": "QOS"
        },
        {
          "flags": [
            "-n",
            "--name"
          ],
          "help": "only these job names",
          "metavar": "NAMES"
        },
        {
          "flags": [
            "--queue"
          ],
          "help": "the job list: mine (default; a job filter shows what it selects), all, or none",
          "metavar": "WHICH"
        },
        {
          "flags": [
            "-a",
            "--all"
          ],
          "help": "everyone's jobs in the job list (--queue all)",
          "metavar": ""
        },
        {
          "flags": [
            "--no-queue"
          ],
          "help": "no job list (--queue none)",
          "metavar": ""
        },
        {
          "flags": [
            "-U",
            "--users"
          ],
          "help": "who holds what (each GPU type under a high QoS and a low one), each user's share of the GPUs, and each team's high QoS quota in use",
          "metavar": ""
        },
        {
          "flags": [
            "-W",
            "--why"
          ],
          "help": "why jobs wait: reason families, then Slurm's codes",
          "metavar": ""
        },
        {
          "flags": [
            "--resources"
          ],
          "help": "the CPU / memory / GPU table",
          "metavar": ""
        },
        {
          "flags": [
            "-d",
            "--detail"
          ],
          "help": "full node states and reasons, and who is behind each pending reason",
          "metavar": ""
        },
        {
          "flags": [
            "--group"
          ],
          "help": "pending jobs above running ones (--no-group: job ID order)",
          "metavar": ""
        },
        {
          "flags": [
            "--split"
          ],
          "help": "break each pool into the partitions it is split across",
          "metavar": ""
        },
        {
          "flags": [
            "-P",
            "--partitions"
          ],
          "help": "pool totals only",
          "metavar": ""
        },
        {
          "flags": [
            "-N",
            "--nodes",
            "--show-nodes"
          ],
          "help": "a flat node list, as in sinfo -N",
          "metavar": ""
        },
        {
          "flags": [
            "--gres"
          ],
          "help": "the generic resource to count (default: the one most nodes have)",
          "metavar": "NAME"
        },
        {
          "flags": [
            "-i",
            "--interval",
            "--iterate"
          ],
          "help": "redraw every SEC seconds (at least 2); while Slurm fails or does not answer, the wait doubles, up to 60s or SEC if longer",
          "metavar": "SEC"
        },
        {
          "flags": [
            "--json"
          ],
          "help": "the model as JSON, for scripts (ignores $SQ_OPTIONS)",
          "metavar": ""
        },
        {
          "flags": [
            "--theme"
          ],
          "help": "catppuccin flavour: mocha (default), macchiato, frappe, latte. $CLUSTER_THEME sets it for every cluster command",
          "metavar": "FLAVOUR"
        },
        {
          "flags": [
            "--themes"
          ],
          "help": "list the flavours with a swatch",
          "metavar": ""
        },
        {
          "flags": [
            "--color",
            "--colour"
          ],
          "help": "always, never or auto (default; $NO_COLOR is honoured)",
          "metavar": "WHEN"
        },
        {
          "flags": [
            "--no-color",
            "--no-colour"
          ],
          "help": "the same as --color never",
          "metavar": ""
        },
        {
          "flags": [
            "--ascii"
          ],
          "help": "ASCII glyphs for terminals without UTF-8",
          "metavar": ""
        },
        {
          "flags": [
            "--wide"
          ],
          "help": "every column at full width, whatever the terminal fits",
          "metavar": ""
        }
      ],
      "summary": "the Slurm queue, who holds what, and what each partition pool has left",
      "summary_ko": "큐, 누가 무엇을 쓰는지, 파티션별 남은 자원",
      "usage": "sq [OPTIONS]"
    }
  },
  "dates": {
    "docker_admin_only_from": "2026-11-25",
    "home_data_move": "2026-12-09",
    "home_downtime": "2026-12-05",
    "limits_from": "2026-12-09",
    "notice_day": "2026-11-25",
    "scratch_cleanup_from": "2026-11-25",
    "submit_holds_from": "2026-12-09"
  },
  "environment": [
    {
      "job": "",
      "login": "~/.cache/huggingface",
      "name": "HF_HOME"
    },
    {
      "job": "/tmp/pip-cache",
      "login": "~/.cache/pip",
      "name": "PIP_CACHE_DIR"
    },
    {
      "job": "",
      "login": "/home/shared/models/hub",
      "name": "SHARED_HF_HUB_CACHE"
    },
    {
      "job": "/tmp/uv-cache",
      "login": "~/.cache/uv",
      "name": "UV_CACHE_DIR"
    }
  ],
  "login": {
    "cpus": 8,
    "memory_gib": 64,
    "tasks": 4096
  },
  "policy": {
    "cancel_after_hours": 6,
    "cancel_warn_hours": 1,
    "grace_days": 14,
    "idle_hours": 2,
    "idle_notify": [
      "mention"
    ],
    "interactive_team_qos": true,
    "leave_grace_days": 60,
    "stale_days": 60,
    "warn_fraction": 0.9
  },
  "quota": {
    "/home": {
      "block_hard_tib": 10.0,
      "block_warn_tib": 9.0,
      "inode_hard": 30000000,
      "inode_warn": 27000000
    },
    "/scratch": {
      "block_hard_tib": 5.0,
      "block_warn_tib": 4.5,
      "inode_hard": 15000000,
      "inode_warn": 13500000
    }
  },
  "reports": {
    "disk": "*-*-* 09:00:00",
    "usage": "hourly",
    "weekly": "Mon *-*-* 09:00:00"
  },
  "slurm": {
    "kill_wait_seconds": 120,
    "preempt_grace_seconds": 120,
    "sigkill_after_seconds": 240
  }
}
