  "commands_retired": {
    "disk-usage": "usage disk",
    "gpu-usage": "usage gpu",
    "scratch-space": "usage disk"
  },
  "commands_retired_pattern": "(?<![#\\w/.-])(scratch\\-space|disk\\-usage|gpu\\-usage)(?![\\w.-])",
  "dates": {
    "home_downtime": "2026-12-05",
    "limits_from": "2026-12-09",
    "notice_day": "2026-11-25"
  },
  "environment": [
    {
      "job": "",
      "login": "~/.cache/huggingface",
      "name": "HF_HOME"
    },
    {
      "job": "/tmp/pip-cache",
      "login": "~/.cache/pip",
      "name": "PIP_CACHE_DIR"
    },
    {
      "job": "",
      "login": "/home/shared/models/hub",
      "name": "SHARED_HF_HUB_CACHE"
    },
    {
      "job": "/tmp/uv-cache",
      "login": "~/.cache/uv",
      "name": "UV_CACHE_DIR"
    }
  ],
  "login": {
    "cpus": 8,
    "memory_gib": 64,
    "tasks": 4096
  },
  "messages": {
    "hold_disk": "Your disk use on",
    "hold_ended": "Your membership ended on",
    "ssh_rate": "새 SSH 접속이 잠시 막혔습니다"
  },
  "paths": {
    "scratch": "/scratch",
    "shared": "/home/shared",
    "shared_data": [
      "datasets",
      "models",
      "containers"
    ],
    "software": "/sw"
  },
  "policy": {
    "cancel_after_hours": 6,
    "cancel_warn_hours": 1,
    "force_gpu_partition": true,
    "gpu_jobs_use_defaults": true,
    "gpu_nodes_shared": true,
    "gpu_type_defaulted": true,
    "gpus_per_node": [
      1,
      2,
      4,
      8
    ],
    "grace_days": 14,
    "idle_hours": 2,
    "interactive_team_qos": true,
    "leave_grace_days": 60,
    "max_submit_jobs": 500,
    "shared_grace_days": 14,
    "shared_stale_days": 60,
    "stale_days": 60,
    "strict_gpu_type": true,
    "submit_holds": true,
    "submit_holds_disk": true,
    "warn_fraction": 0.9
  },
  "quota": {
    "/home": {
      "block_hard_tib": 10.0,
      "block_warn_tib": 9.0,
      "inode_hard": 30000000,
      "inode_warn": 27000000
    },
    "/scratch": {
      "block_hard_tib": 5.0,
      "block_warn_tib": 4.5,
      "inode_hard": 15000000,
      "inode_warn": 13500000
    }
  },
  "reports": {
    "disk": "*-*-* 09:00:00",
    "usage": "hourly",
    "weekly": "Mon *-*-* 09:00:00"
  },
  "rules": [
    {
      "action": "notice, cancel",
      "active": true,
      "anchor": "policy/rules/#gpu-idle",
      "check": "usage gpu",
      "id": "gpu-idle",
      "title": "GPU 유휴 잡",
      "values": {
        "slurm_usage_report_cancel_after_hours": 6,
        "slurm_usage_report_cancel_warn_hours": 1,
        "slurm_usage_report_idle_hours": 2,
        "slurm_usage_report_idle_util_threshold": 0
      }
