  "dates": {
    "home_downtime": "2026-12-05",
    "limits_from": "2026-12-09",
    "notice_day": "2026-11-25"
  },
  "environment": [
    {
      "job": "",
      "login": "~/.cache/huggingface",
      "name": "HF_HOME"
    },
    {
      "job": "/tmp/pip-cache",
      "login": "~/.cache/pip",
      "name": "PIP_CACHE_DIR"
    },
    {
      "job": "",
      "login": "/home/shared/models/hub",
      "name": "SHARED_HF_HUB_CACHE"
    },
    {
      "job": "/tmp/uv-cache",
      "login": "~/.cache/uv",
      "name": "UV_CACHE_DIR"
    }
  ],
  "login": {
    "cpus": 8,
    "memory_gib": 64,
    "tasks": 4096
  },
  "messages": {
    "hold_disk": "Your disk use on",
    "hold_ended": "Your membership ended on"
  },
  "paths": {
    "scratch": "/scratch",
    "shared": "/home/shared",
    "shared_data": [
      "datasets",
      "models",
      "containers"
    ],
    "software": "/sw"
  },
  "policy": {
    "cancel_after_hours": 6,
    "cancel_warn_hours": 1,
    "force_gpu_partition": true,
    "gpu_jobs_use_defaults": true,
    "gpu_nodes_shared": true,
    "gpu_type_defaulted": true,
    "gpus_per_node": [
      1,
      2,
      4,
      8
    ],
    "grace_days": 14,
    "idle_hours": 2,
    "idle_notify": [
      "mention"
    ],
    "interactive_team_qos": true,
    "leave_grace_days": 60,
    "max_submit_jobs": 500,
    "stale_days": 60,
    "strict_gpu_type": true,
    "submit_holds": true,
    "submit_holds_disk": true,
    "warn_fraction": 0.9
  },
  "quota": {},
  "reports": {
    "disk": "*-*-* 09:00:00",
    "usage": "hourly",
    "weekly": "Mon *-*-* 09:00:00"
  },
  "schedules": {
    "scratch_purge": "*-*-* 03:30:00"
  },
  "services": {
    "bot": true,
    "dashboard": true,
    "dashboards": [
      {
        "title": "GPU / Nodes",
        "uid": "gpu-nodes"
      },
      {
        "title": "Node Exporter / Hosts",
        "uid": "node-exporter-hosts"
      },
      {
        "title": "Slurm / Scheduler",
        "uid": "slurm-scheduler"
      },
      {
        "title": "Storage / NFS and disks",
        "uid": "storage-io"
      },
      {
        "title": "Storage / per person",
        "uid": "storage-person"
      },
      {
        "title": "Slurm / GPU allocation",
        "uid": "slurm-gpu-allocation"
      }
    ],
    "job_notices": true,
    "menu": [
      "Grafana"
    ],
    "overview": "클러스터",
    "portal": true,
    "portal_files": [
      "/home"
    ],
    "portal_groups": [
      "apps",
      "files",
      "jobs",
      "clusters"
    ]
  },
  "slurm": {
    "kill_wait_seconds": 120,
    "preempt_grace_seconds": 120,
    "sigkill_after_seconds": 240
  },
  "storage": {
    "/home": {
      "read_bps": 1272070703,
      "read_iops": 1587,
      "write_bps": 894575285,
      "write_iops": 483
    }
  },
  "threads": {
    "variables": [
      {
        "default": "one thread per CPU",
        "kind": "threads",
        "name": "OMP_NUM_THREADS",
        "reader": "OpenMP runtimes (libgomp, libomp), PyTorch's intra-op pool, GNU nproc",
        "value": "{n}"
      },
      {
        "default": "one thread per physical core",
        "kind": "threads",
        "name": "MKL_NUM_THREADS",
        "reader": "Intel oneMKL (NumPy and SciPy built on it)",
        "value": "{n}"
      },
      {
        "default": "one thread per CPU",
        "kind": "threads",
        "name": "OPENBLAS_NUM_THREADS",
        "reader": "OpenBLAS (NumPy and SciPy wheels)",
        "value": "{n}"
      },
      {
        "default": "one thread (multithreaded builds read this)",
        "kind": "threads",
        "name": "BLIS_NUM_THREADS",
        "reader": "BLIS and AMD AOCL-BLAS",
        "value": "{n}"
      },
      {
        "default": "the CPUs, at most 8",
        "kind": "threads",
        "name": "NUMEXPR_NUM_THREADS",
        "reader": "NumExpr (pandas' eval)",
        "value": "{n}"
      },
      {
        "default": "64",
        "kind": "threads",
        "name": "NUMEXPR_MAX_THREADS",
        "reader": "NumExpr's pool, started at import",
        "value": "{n}"
      },
      {
        "default": "one thread per CPU core",
        "kind": "threads",
        "name": "NUMBA_NUM_THREADS",
        "reader": "Numba's parallel CPU target",
        "value": "{n}"
      },
      {
        "default": "one thread per CPU Rust sees",
        "kind": "threads",
        "name": "RAYON_NUM_THREADS",
        "reader": "Rust's Rayon pool (Hugging Face tokenizers, Polars)",
        "value": "{n}"
      },
      {
        "default": "one thread per CPU",
        "kind": "threads",
        "name": "POLARS_MAX_THREADS",
        "reader": "Polars",
        "value": "{n}"
      },
      {
        "default": "one thread per CPU",
        "kind": "threads",
        "name": "TF_NUM_INTRAOP_THREADS",
        "reader": "TensorFlow's intra-op pool",
        "value": "{n}"
      },
      {
        "default": "the CPUs, or the process's own cgroup's limit",
        "kind": "threads",
        "name": "GOMAXPROCS",
        "reader": "Go programs",
        "value": "{n}"
      },
      {
        "default": "the CPUs",
        "kind": "threads",
        "name": "PYTHON_CPU_COUNT",
        "reader": "Python 3.13+ os.cpu_count() (multiprocessing and concurrent.futures pools)",
        "value": "{n}"
      },
      {
        "default": "one compiler per CPU",
        "kind": "build",
        "name": "MAX_JOBS",
        "reader": "PyTorch C++/CUDA extension builds (torch.utils.cpp_extension, ninja)",
        "value": "{n}"
      },
      {
        "default": "4",
        "kind": "build",
        "name": "NVCC_THREADS",
        "reader": "flash-attn's build (nvcc --threads)",
        "value": "1"
      },
      {
        "default": "the native build tool's (make one job, ninja one per CPU)",
        "kind": "build",
        "name": "CMAKE_BUILD_PARALLEL_LEVEL",
        "reader": "cmake --build",
        "value": "{n}"
      },
      {
        "default": "one compiler per CPU",
        "kind": "build",
        "name": "CARGO_BUILD_JOBS",
        "reader": "cargo",
        "value": "{n}"
      },
      {
        "default": "one per CPU",
        "kind": "build",
        "name": "UV_CONCURRENT_BUILDS",
        "reader": "uv building source distributions",
        "value": "{n}"
      },
      {
        "default": "one job",
        "kind": "build",
        "name": "MAKEFLAGS",
        "reader": "GNU make",
        "value": "-j{n}"
      }
    ]
  }
}
