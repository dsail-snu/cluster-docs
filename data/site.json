    "sq": {
      "options": [
        {
          "flags": [
            "-m",
            "--me"
          ],
          "help": "only your jobs",
          "metavar": ""
        },
        {
          "flags": [
            "-u",
            "--user"
          ],
          "help": "only these users (comma list; * and ? match)",
          "metavar": "USER"
        },
        {
          "flags": [
            "-p",
            "--partition"
          ],
          "help": "only these partitions",
          "metavar": "PART"
        },
        {
          "flags": [
            "-w",
            "--nodelist"
          ],
          "help": "only these nodes (a hostlist like gpu[1-3,8], or globs)",
          "metavar": "NODES"
        },
        {
          "flags": [
            "-t",
            "--states",
            "--state"
          ],
          "help": "only these job states (R,PD or running,pending; all includes finished)",
          "metavar": "STATES"
        },
        {
          "flags": [
            "-j",
            "--jobs"
          ],
          "help": "only these job IDs",
          "metavar": "IDS"
        },
        {
          "flags": [
            "-A",
            "--account"
          ],
          "help": "only these accounts",
          "metavar": "ACCOUNTS"
        },
        {
          "flags": [
            "-q",
            "--qos"
          ],
          "help": "only these QoS",
          "metavar": "QOS"
        },
        {
          "flags": [
            "-n",
            "--name"
          ],
          "help": "only these job names",
          "metavar": "NAMES"
        },
        {
          "flags": [
            "--queue"
          ],
          "help": "the job list: mine (default; a job filter shows what it selects), all, or none",
          "metavar": "WHICH"
        },
        {
          "flags": [
            "-a",
            "--all"
          ],
          "help": "everyone's jobs in the job list (--queue all)",
          "metavar": ""
        },
        {
          "flags": [
            "--no-queue"
          ],
          "help": "no job list (--queue none)",
          "metavar": ""
        },
        {
          "flags": [
            "-U",
            "--users"
          ],
          "help": "who holds what (each GPU type under a high QoS and a low one), each user's share of the GPUs, and each team's high QoS quota in use",
